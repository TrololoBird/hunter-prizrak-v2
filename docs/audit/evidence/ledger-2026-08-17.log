### подозрительная геометрия
    SELECT id, symbol AS символ, direction AS сторона, entry AS вход, stop AS стоп, ROUND(ABS(entry - stop) / entry * 100, 4) AS дистанция_стопа_проц FROM signals WHERE (direction = 'long'  AND stop >= entry)    OR (direction = 'short' AND stop <= entry)    OR ABS(entry - stop) / entry < 0.0005    OR ABS(entry - stop) / entry > 0.5 ORDER BY дистанция_стопа_проц;
