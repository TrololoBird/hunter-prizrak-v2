__pycache__/
*.py[cod]
.venv/
data/
*.sqlite3
# Кадры прогонов — под data/, в репозиторий не идут.
# Но эталонный срез гейта-оракула идти ОБЯЗАН: без него гейт печатает
# «проверка не состоялась» и падает (проверено — так и случилось в CI 2026-08-03).
*.parquet
!docs/audit/reference-slice/*.parquet

# страницы курса — рендерятся локально одной командой (см. CLAUDE.md), в git не нужны
docs/course/pages/

# Личные переопределения Claude Code — у каждого свои, в репозиторий не идут.
# Общие настройки, хуки и команды проекта (.claude/settings.json, hooks/, commands/)
# наоборот КОММИТЯТСЯ: они часть того, как проект проверяется.
.claude/settings.local.json
.scratch/

# Выгрузка Telegram-канала автора — данные владельца, чужой контент; в git НЕ идёт
# (разбор с цитатами — docs/audit/tg-prizrak-2026-08.md, он идёт).
prizzrak-tg/

# Живые логи боевых процессов (бот, serve) — по стоп-листу смены в git не идут:
# растут, содержат оперативные данные; их выжимки цитируются в журналах смен.
docs/audit/evidence/bot-restart*.log
docs/audit/evidence/bot-restart*.log.err
docs/audit/evidence/bot-restart*.err.log
docs/audit/evidence/serve*.log
docs/audit/evidence/serve*.log.err
