{
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(bash scripts/check.sh)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh repo view *)",
      "Bash(ls *)",
      "Bash(du *)",
      "Bash(wc *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(curl * | *)",
      "Read(./.credentials.json)"
    ]
  },
  "env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "disableClaudeAiConnectors": true,
  "worktree": {
    "symlinkDirectories": [
      "data",
      ".venv"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "uv run python ${CLAUDE_PROJECT_DIR}/.claude/hooks/commit_gate.py",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "uv run python ${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_data.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python ${CLAUDE_PROJECT_DIR}/.claude/hooks/lint_edited.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
